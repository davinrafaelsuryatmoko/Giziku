<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Biru Atas -->
    <View
        android:id="@+id/topBg"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@color/biru"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Judul -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PROFIL"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/topBg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/topBg"
        app:layout_constraintVertical_bias="0.3" />

    <!-- Kartu Profil -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/topBg"
        android:layout_marginTop="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="90dp"
            android:background="@drawable/bg_white_round"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Logo -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:src="@mipmap/ic_launcher_round"
                android:contentDescription="Logo" />

            <!-- Garis -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#CCCCCC" android:layout_marginBottom="16dp"/>

            <!-- Nama -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Nama" android:textColor="#888" android:textSize="13sp"/>
            <TextView
                android:id="@+id/tvNamaProfil"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:text="-"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <!-- Email -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Email" android:textColor="#888" android:textSize="13sp"/>
            <TextView
                android:id="@+id/tvEmailProfil"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:text="-"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <!-- No Telepon -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="No Telepon" android:textColor="#888" android:textSize="13sp"/>
            <TextView
                android:id="@+id/tvPhoneProfil"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:text="-"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>

            <!-- Tombol Keluar -->
            <Button
                android:id="@+id/btnKeluar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="KELUAR"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_button_add" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>